{
  "name": "@c3theme/engine-node",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "description": "Backend Node do contrato C3 (spec/v0): /_meta, CRUD, condições, ações e erros sobre SQLite, com a semântica do c3-engine",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "c3theme-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./better-sqlite3": {
      "c3theme-source": "./src/adapters/better-sqlite3.ts",
      "types": "./dist/adapters/better-sqlite3.d.ts",
      "default": "./dist/adapters/better-sqlite3.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/fix-dist-imports.mjs dist",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "better-sqlite3": ">=11"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^12.11.1",
    "typescript": "~6.0.3"
  }
}
