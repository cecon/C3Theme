{
  "name": "@c3theme/engine",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Renderer da shell C3: lê /_meta do backend e monta layout, menu, rotas, listas e formulários com o @c3theme/ui",
  "author": "cecon (https://github.com/cecon)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecon/C3Theme.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/cecon/C3Theme/tree/main/packages/engine#readme",
  "bugs": {
    "url": "https://github.com/cecon/C3Theme/issues"
  },
  "keywords": [
    "c3theme",
    "mui",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "c3theme-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-utils.ts",
    "!src/**/*.test-utils.tsx"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/copy-src-modules.mjs src dist && node ../../scripts/fix-dist-imports.mjs dist",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/x-charts": "^9.15.0",
    "iconsax-reactjs": "^0.0.8"
  },
  "peerDependencies": {
    "@c3theme/chat": "^0.11.0",
    "@c3theme/flow": "^0.3.0",
    "@c3theme/ui": "^0.1.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^12.0.0",
    "react-router": "^8.0.0",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@c3theme/chat": "workspace:*",
    "@c3theme/flow": "workspace:*",
    "@c3theme/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.3",
    "react-router": "^8.4.0",
    "swr": "^2.5.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
