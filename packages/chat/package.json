{
  "name": "@c3theme/chat",
  "version": "0.8.0",
  "license": "MIT",
  "description": "C3 Chat: contrato de mensagens, porta de transporte e hooks headless; os componentes visuais vêm sobre o @c3theme/ui",
  "author": "cecon (https://github.com/cecon)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecon/C3Theme.git",
    "directory": "packages/chat"
  },
  "homepage": "https://github.com/cecon/C3Theme/tree/main/packages/chat#readme",
  "bugs": {
    "url": "https://github.com/cecon/C3Theme/issues"
  },
  "keywords": [
    "c3theme",
    "mui",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "c3theme-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "c3theme-source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/fix-dist-imports.mjs dist",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@c3theme/ui": "^0.1.0",
    "@mui/material": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^12.0.0"
  },
  "devDependencies": {
    "@c3theme/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "iconsax-reactjs": "^0.0.8"
  },
  "peerDependenciesMeta": {
    "@c3theme/ui": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-intl": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    }
  }
}
