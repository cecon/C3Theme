{
  "name": "@c3theme/ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "C3 UI: tema, layout e componentes próprios sobre o MUI",
  "author": "cecon (https://github.com/cecon)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecon/C3Theme.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/cecon/C3Theme/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/cecon/C3Theme/issues"
  },
  "keywords": [
    "c3theme",
    "mui",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "c3theme-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./table": {
      "c3theme-source": "./src/table/index.ts",
      "types": "./dist/table/index.d.ts",
      "default": "./dist/table/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/fix-dist-imports.mjs dist",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "iconsax-reactjs": "^0.0.8",
    "qrcode-generator": "2.0.4",
    "stylis": "^4.2.0",
    "stylis-plugin-rtl": "^2.1.1"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intl": "^12.0.0",
    "react-router": "^8.0.0",
    "@tanstack/react-table": "^8.21.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.3",
    "react-router": "^8.4.0",
    "@types/stylis": "^4.2.7",
    "typescript": "~6.0.3",
    "@tanstack/react-table": "^8.21.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./table": {
        "types": "./dist/table/index.d.ts",
        "default": "./dist/table/index.js"
      }
    }
  }
}
