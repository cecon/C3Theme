{
  "name": "@c3theme/electron",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Adaptadores do motor C3 para Electron: o renderer pede por IPC e o processo main repassa ao backend (remoto ou binário local)",
  "author": "cecon (https://github.com/cecon)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cecon/C3Theme.git",
    "directory": "packages/electron"
  },
  "homepage": "https://github.com/cecon/C3Theme/tree/main/packages/electron#readme",
  "bugs": {
    "url": "https://github.com/cecon/C3Theme/issues"
  },
  "keywords": [
    "c3theme",
    "electron",
    "ipc"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./renderer": {
      "c3theme-source": "./src/renderer.ts",
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./preload": {
      "c3theme-source": "./src/preload.ts",
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./main": {
      "c3theme-source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-util.ts"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/fix-dist-imports.mjs dist",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./renderer": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "./preload": {
        "types": "./dist/preload.d.ts",
        "default": "./dist/preload.js"
      },
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    }
  }
}
