    "dev": "pnpm run build && pnpm run start",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@c3theme/engine-node": "workspace:*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  }
}
