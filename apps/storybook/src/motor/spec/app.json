{
  "$schema": "../../../../../spec/v0/app.schema.json",
  "specVersion": "0",
  "name": "Storybook pelo motor",
  "entities": [
    "agente",
    "produto",
    "fatura",
    "loja",
    "cliente",
    "vendedor",
    "fornecedor",
    "tarefa",
    "evento",
    "mesa",
    "movimento",
    "inventario",
    "inventario_item",
    "configuracao_loja",
    "nota_item",
    "conta_contabil",
    "orcado_realizado",
    "orcamento",
    "demonstrativo",
    "boleto",
    "entrega",
    "posicao_estoque",
    "agenda_entrega",
    "automacao"
  ],
  "layout": {
    "orientation": "vertical",
    "header": {
      "assistant": {
        "title": "Assistente",
        "suggestions": ["Cadastrar o cliente Padaria Bom Dia", "Relatório de faturas do mês"]
      },
      "search": {
        "records": true
      },
      "notifications": true,
      "fullscreen": true,
      "settings": true
    },
    "menu": [
      {
        "title": "Início",
        "items": [
          {
            "path": "/painel",
            "icon": "Home2"
          }
        ]
      },
      {
        "title": "Cadastros",
        "items": [
          {
            "entity": "cliente",
            "icon": "People"
          },
          {
            "entity": "produto",
            "icon": "Box"
          },
          {
            "entity": "fornecedor",
            "icon": "Truck"
          },
          {
            "entity": "loja",
            "icon": "Shop"
          },
          {
            "entity": "vendedor",
            "icon": "Profile2User"
          }
        ]
      },
      {
        "title": "Financeiro",
        "items": [
          {
            "title": "Faturas",
            "icon": "ReceiptText",
            "children": [
              {
                "entity": "fatura",
                "title": "Todas"
              },
              {
                "entity": "fatura",
                "preset": "atrasadas",
                "title": "Atrasadas",
                "badge": true
              }
            ]
          }
        ]
      },
      {
        "title": "Operação",
        "items": [
          {
            "entity": "tarefa",
            "view": "board",
            "title": "Quadro de tarefas",
            "icon": "TaskSquare"
          },
          {
            "entity": "evento",
            "view": "calendar",
            "title": "Agenda",
            "icon": "Calendar"
          },
          {
            "entity": "fatura",
            "view": "report",
            "title": "Relatório de faturas",
            "icon": "DocumentText"
          },
          {
            "entity": "mesa",
            "view": "map",
            "title": "Planta",
            "icon": "Element3"
          }
        ]
      }
    ],
    "footer": {
      "text": "Storybook do C3, montado pelo motor"
    }
  },
  "pages": [
    {
      "path": "/assistente",
      "title": "Assistente",
      "chat": {
        "title": "Assistente",
        "steer": true,
        "placeholder": "Peça um cadastro ou um relatório",
        "suggestions": ["Cadastrar o cliente Padaria Bom Dia", "Relatório de faturas do mês", "Pesquisar faturas atrasadas"],
        "parts": ["c3.form", "c3.record", "c3.action"]
      }
    },
    {
      "path": "/conversa/:conversation",
      "title": "Conversa",
      "chat": {
        "conversation": "{conversation}",
        "title": "Conversa do pedido",
        "placeholder": "Pergunte sobre este pedido",
        "parts": ["c3.form", "c3.record", "c3.action"]
      }
    },
    {
      "path": "/uso",
      "title": "Uso",
      "dashboard": {
        "source": { "path": "/uso", "refresh": 5 },
        "widgets": [
          {
            "type": "meter",
            "title": "Uso por provedor",
            "subtitle": "Tokens na janela atual",
            "from": "provedores",
            "label": "nome",
            "value": "tokens.total",
            "limit": "tokens.limite",
            "details": [
              { "label": "Entrada", "value": "tokens.entrada" },
              { "label": "Saída", "value": "tokens.saida" },
              { "label": "Início da janela", "value": "janela.inicio", "format": "datetime" },
              { "label": "Fim da janela", "value": "janela.fim", "format": "datetime" },
              { "label": "Custo estimado", "value": "custo.valor", "format": "money", "currency": "custo.moeda" }
            ]
          },
          {
            "type": "share",
            "title": "Consumo por agente",
            "subtitle": "Participação no total de tokens",
            "from": "agentes",
            "label": "nome",
            "value": "tokens",
            "share": "participacao"
          },
          {
            "type": "status",
            "title": "Atualização do app",
            "from": "atualizacao",
            "state": "estado",
            "states": {
              "verificando": { "label": "Verificando", "tone": "info" },
              "disponivel": { "label": "Versão nova disponível", "tone": "primary" },
              "baixando": { "label": "Baixando", "tone": "info" },
              "pronto": { "label": "Pronto para instalar", "tone": "success" },
              "atualizado": { "label": "Atualizado", "tone": "success" },
              "erro": { "label": "Falhou", "tone": "danger" }
            },
            "fields": [
              { "label": "Versão atual", "value": "atual", "format": "text" },
              { "label": "Versão disponível", "value": "disponivel", "format": "text" },
              { "label": "Canal", "value": "canal", "format": "text" }
            ],
            "notices": [
              { "when": { "field": "canal", "op": "eq", "value": "beta" }, "text": "Canal beta: versões de teste podem ter falhas.", "tone": "warning" }
            ],
            "progress": "progresso",
            "message": "mensagem",
            "actions": [
              { "id": "verificar", "label": "Verificar agora", "path": "/atualizacao/verificar" },
              { "id": "baixar", "label": "Baixar", "path": "/atualizacao/baixar", "variant": "contained" },
              { "id": "instalar", "label": "Instalar e reiniciar", "path": "/atualizacao/instalar", "variant": "contained" },
              { "id": "tentar", "label": "Tentar de novo", "path": "/atualizacao/verificar" }
            ]
          }
        ]
      }
    },
    {
      "path": "/painel",
      "title": "Painel de faturas",
      "dashboard": {
        "actions": [
          {
            "label": "Ver todas",
            "path": "/fatura"
          }
        ],
        "widgets": [
          {
            "type": "kpi",
            "title": "Total faturado",
            "entity": "fatura",
            "where": {
              "field": "status",
              "op": "ne",
              "value": "cancelada"
            },
            "measure": "sum:total",
            "icon": "ReceiptText",
            "tone": "primary",
            "count": true,
            "progress": {
              "label": "recebido",
              "part": {
                "field": "status",
                "op": "eq",
                "value": "paga"
              }
            }
          },
          {
            "type": "kpi",
            "title": "Pagas",
            "entity": "fatura",
            "where": {
              "field": "status",
              "op": "eq",
              "value": "paga"
            },
            "measure": "sum:total",
            "icon": "TickCircle",
            "tone": "success",
            "count": true
          },
          {
            "type": "kpi",
            "title": "Atrasadas",
            "entity": "fatura",
            "where": {
              "field": "status",
              "op": "eq",
              "value": "atrasada"
            },
            "measure": "sum:total",
            "icon": "Warning2",
            "tone": "danger",
            "count": true
          },
          {
            "type": "chart",
            "title": "Faturado por mês",
            "entity": "fatura",
            "groupBy": "emissao",
            "interval": "month",
            "measure": "sum:total",
            "chart": "area",
            "empty": "Nenhuma fatura no período.",
            "width": 8
          },
          {
            "type": "chart",
            "title": "Situação das faturas",
            "entity": "fatura",
            "groupBy": "status",
            "measure": "sum:total",
            "chart": "donut",
            "width": 4
          },
          {
            "type": "heatmap",
            "title": "Faturas emitidas por dia",
            "entity": "fatura",
            "groupBy": "emissao",
            "tone": "primary"
          },
          {
            "type": "ranking",
            "title": "Maiores devedores",
            "entity": "fatura",
            "groupBy": "cliente",
            "measure": "sum:total",
            "where": {
              "field": "status",
              "op": "eq",
              "value": "atrasada"
            },
            "caption": "{count} {label} atrasadas",
            "width": 12
          }
        ]
      }
    },
    {
      "path": "/vencimentos",
      "title": "Vencimentos",
      "dashboard": {
        "filters": [
          {
            "name": "venc",
            "type": "period",
            "label": "Vence em",
            "default": "next30",
            "options": ["today", "next7", "next30", "nextMonth"]
          }
        ],
        "widgets": [
          {
            "type": "kpi",
            "title": "A receber",
            "entity": "boleto",
            "measure": "sum:valor",
            "icon": "Calendar",
            "tone": "warning",
            "count": true,
            "bind": {
              "venc": "vencimento"
            }
          },
          {
            "type": "ranking",
            "title": "Quem vai pagar",
            "entity": "boleto",
            "groupBy": "cliente",
            "measure": "sum:valor",
            "caption": "{count} {label}",
            "bind": {
              "venc": "vencimento"
            },
            "width": 8
          }
        ]
      }
    },
    {
      "path": "/financeiro",
      "title": "Financeiro",
      "dashboard": {
        "widgets": [
          {
            "type": "kpi",
            "title": "Faturado em outubro",
            "entity": "fatura",
            "measure": "sum:total",
            "icon": "ReceiptText",
            "tone": "primary",
            "where": {
              "and": [
                {
                  "field": "emissao",
                  "op": "gte",
                  "value": "2026-10-01"
                },
                {
                  "field": "emissao",
                  "op": "lte",
                  "value": "2026-10-31"
                }
              ]
            },
            "compare": {
              "label": "setembro",
              "where": {
                "and": [
                  {
                    "field": "emissao",
                    "op": "gte",
                    "value": "2026-09-01"
                  },
                  {
                    "field": "emissao",
                    "op": "lte",
                    "value": "2026-09-30"
                  }
                ]
              }
            },
            "width": 4
          },
          {
            "type": "kpi",
            "title": "Atrasado em outubro",
            "entity": "fatura",
            "measure": "sum:total",
            "icon": "Warning2",
            "tone": "danger",
            "where": {
              "and": [
                {
                  "field": "status",
                  "op": "eq",
                  "value": "atrasada"
                },
                {
                  "field": "emissao",
                  "op": "gte",
                  "value": "2026-10-01"
                },
                {
                  "field": "emissao",
                  "op": "lte",
                  "value": "2026-10-31"
                }
              ]
            },
            "compare": {
              "label": "setembro",
              "invert": true,
              "where": {
                "and": [
                  {
                    "field": "status",
                    "op": "eq",
                    "value": "atrasada"
                  },
                  {
                    "field": "emissao",
                    "op": "gte",
                    "value": "2026-09-01"
                  },
                  {
                    "field": "emissao",
                    "op": "lte",
                    "value": "2026-09-30"
                  }
                ]
              }
            },
            "width": 4
          },
          {
            "type": "alert",
            "entity": "fatura",
            "preset": "atrasadas",
            "measure": "sum:total",
            "text": "{count} faturas atrasadas somando {value}",
            "tone": "error"
          },
          {
            "type": "list",
            "title": "Títulos",
            "entity": "fatura",
            "columns": ["numero", "cliente", "vencimento", "total"],
            "sort": "vencimento",
            "limit": 20,
            "tabs": [
              {
                "label": "Em aberto",
                "where": {
                  "field": "status",
                  "op": "eq",
                  "value": "aberta"
                }
              },
              {
                "label": "Atrasadas",
                "preset": "atrasadas"
              },
              {
                "label": "Boletos",
                "entity": "boleto",
                "columns": ["numero", "cliente", "vencimento", "valor"]
              }
            ],
            "width": 6
          },
          {
            "type": "list",
            "title": "Todas as faturas",
            "entity": "fatura",
            "columns": ["numero", "cliente", "status", "total"],
            "sort": "-emissao",
            "limit": 42,
            "filter": "status",
            "width": 6
          }
        ]
      }
    },
    {
      "path": "/apis",
      "title": "Documentação da API",
      "apiDocs": {
        "spec": "/openapi.json"
      }
    },
    {
      "path": "/primeira-configuracao",
      "title": "Primeira configuração",
      "wizard": {
        "entity": "configuracao_loja",
        "pending": "pendente",
        "steps": [
          {
            "title": "A loja",
            "description": "Os dados que vão na nota fiscal.",
            "rows": [["cnpj"], ["razao_social", "fantasia"], ["regime"]]
          },
          {
            "title": "Este computador",
            "description": "O caixa que vai vender aqui.",
            "rows": [["maquina", "caixa"]]
          },
          {
            "title": "Impressora",
            "description": "Dá para configurar depois.",
            "rows": [["impressora"]],
            "optional": true
          }
        ],
        "summary": {
          "title": "Loja configurada",
          "description": "Já dá para vender. O que falta pode ser feito depois.",
          "items": [
            {
              "label": "Certificado digital",
              "done": "tem_certificado",
              "path": "/configuracao_loja"
            },
            {
              "label": "Impressora",
              "done": "tem_impressora",
              "path": "/configuracao_loja"
            }
          ]
        }
      }
    }
  ],
  "authorization": {
    "codes": ["orcamento_excedido"],
    "title": "Liberação do orçamento",
    "fields": [
      {
        "name": "usuario",
        "label": "Usuário que libera"
      },
      {
        "name": "senha",
        "label": "Senha",
        "type": "password"
      },
      {
        "name": "motivo",
        "label": "Motivo",
        "type": "text",
        "minLength": 5
      }
    ]
  }
}
