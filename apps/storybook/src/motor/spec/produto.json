    { "name": "preco", "type": "decimal", "label": "Preço de venda", "scale": 2, "min": 0, "currency": "BRL", "required": true },
    { "name": "custo", "type": "decimal", "label": "Custo médio", "scale": 2, "currency": "BRL", "readOnly": true },
    { "name": "estoque", "type": "integer", "label": "Estoque", "min": 0 },
    { "name": "ativo", "type": "boolean", "label": "Ativo", "default": true }
