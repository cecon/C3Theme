{
  "name": "c3theme",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @c3theme/seed dev",
    "dev:seed": "pnpm --filter @c3theme/seed dev",
    "dev:engine": "pnpm --filter @c3theme/engine-demo dev",
    "electron": "pnpm --filter @c3theme/electron-example build && pnpm --filter @c3theme/electron-example start",
    "dev:showcase": "pnpm --filter @c3theme/showcase dev",
    "storybook": "pnpm --filter @c3theme/storybook dev",
    "build:storybook": "pnpm --filter @c3theme/storybook build",
    "a11y:storybook": "node scripts/storybook-a11y.mjs",
    "build": "pnpm -r build",
    "build:seed": "pnpm --filter @c3theme/seed build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages apps scripts --max-warnings 0",
    "format": "prettier --write \"{packages,apps}/*/src/**/*.{ts,tsx,json}\"",
    "create-app": "node scripts/create-app.mjs",
    "spec:check": "node scripts/validate-spec.mjs && node scripts/validate-spec.mjs templates/create-app/spec && node scripts/validate-spec.mjs apps/showcase/src/sections/motor/spec && node scripts/validate-spec.mjs plugins/c3/skills/c3-spec/examples && node scripts/validate-spec.mjs apps/storybook/src/motor/spec",
    "skills:check": "node scripts/check-skills.mjs",
    "lines:check": "node scripts/check-lines.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "test": "vitest run",
    "conformance": "node scripts/conformance.mjs",
    "test:coverage": "vitest run --coverage",
    "coverage:rust": "node scripts/coverage-rust.mjs",
    "coverage:packages": "node scripts/coverage-by-package.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "3.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "3.2.4",
    "yaml": "^2.9.1"
  }
}
